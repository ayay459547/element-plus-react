{
  "name": "@ayay459547/element-plus-react",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "private": false,
  "type": "module",
  "homepage": "https://ayay459547.github.io/element-plus-react/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ayay459547/element-plus-react"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "tsc-build": "tsc -b && vite build",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,scss,md}\"",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "build": "vite build",
    "gh-pages": "gh-pages -d dist-demo",
    "page-deploy": "npm run build && gh-pages -d dist-demo",
    "deploy": "node ./scripts/deploy.js",
    "lib-build": "vite build --mode library && tsc -p tsconfig.build.json",
    "local-build": "vite build --mode localhost",
    "publish": "node ./scripts/publish.js"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": "./*"
  },
  "style": "dist/index.css",
  "keywords": [
    "element",
    "element-plus",
    "element-plus-react",
    "component library",
    "ui framework",
    "ui",
    "react"
  ],
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-transition-group": "^4.4.12",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "sass": "^1.99.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "unocss": "^66.6.0",
    "vite": "^8.0.13",
    "vite-plugin-dts": "^5.0.0",
    "vite-plugin-svgr": "^5.2.0"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@floating-ui/react-dom": "^2.1.8",
    "@popperjs/core": "^2.11.8",
    "@reactuses/core": "^6.3.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "clsx": "^2.1.1",
    "nprogress": "^0.2.0",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.1",
    "react-syntax-highlighter": "^16.1.1",
    "react-transition-group": "^4.4.5",
    "rehype-raw": "^7.0.0",
    "rehype-react": "^8.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "lint-staged": {
    "*.{vue,js,ts,jsx,tsx,md,json}": [
      "eslint --fix --concurrency=auto",
      "prettier --write --experimental-cli"
    ]
  }
}
