{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "rootDir": "packages",
    "outDir": "dist",
    "noEmit": false,
    "moduleResolution": "Bundler",
    "types": ["node", "vite/client", "vite-plugin-svgr/client"]
  },
  "include": ["packages/**/*"]
}
